{
  "services": {
    "nil-valuation-api": {
      "root": ".",
      "entrypoint": "api/index.py",
      "buildCommand": "pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "nil-valuation-api"
      }
    }
  ]
}
